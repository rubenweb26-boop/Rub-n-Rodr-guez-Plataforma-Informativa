# Dependencies
/node_modules/
/CRM/node_modules/
/backend/node_modules/
/CRM/dist/
/CRM/.env*
!/CRM/.env.example
/backend/.env*
!/backend/.env.example
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
!.env.example
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# Official geographic source files are retained locally for legal review only.
# SNIT terms restrict commercial reuse; do not ship derived data without written permission.
/data/source/*.geojson
/data/source/*.csv
/data/source/*.xlsx
/data/costa-rica-dta.json

# OS metadata
.DS_Store
