# Tilopay Hosted Payment Page is inert unless this flag is explicitly true and
# every required server-only credential is present. Never prefix these with
# NEXT_PUBLIC_. Testing and production use the same official API host.
TILOPAY_PAYMENTS_ENABLED=false
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_KEY=
TILOPAY_MERCHANT_ID=
TILOPAY_API_BASE_URL=https://app.tilopay.com
# Fixed HTTPS callback registered for this deployment. Do not derive it from a
# browser-supplied Host/Origin header.
TILOPAY_CALLBACK_URL=

# Recurring billing (subscriptions). Requires TILOPAY_PAYMENTS_ENABLED=true and
# a plan created in Tilopay with POST /api/v1/createPlanRepeat. Without a valid
# numeric id, checkout stays inert instead of charging the wrong plan.
TILOPAY_RECURRING_ENABLED=false
TILOPAY_RECURRING_PLAN_ID=
TILOPAY_RECURRING_PLAN_CODE=contenido-mensual
TILOPAY_RECURRING_FREQUENCY=monthly

# Public Supabase values. The publishable key is safe in the browser only
# because every table and Storage bucket is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile. Keep the secret server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional canonical host. If omitted, the hostname of each request is used.
TURNSTILE_EXPECTED_HOSTNAME=

# 32 random bytes encoded as base64url, plus a version label for rotation.
DATA_ENCRYPTION_KEY_V1=
# Keep V1 available while decrypting existing V1 records during a rotation.
DATA_ENCRYPTION_KEY_V2=
DATA_ENCRYPTION_KEY_VERSION=v1

# Independent random secrets used to pseudonymize audit/rate-limit identifiers.
AUDIT_HMAC_KEY=
RATE_LIMIT_HMAC_KEY=

# Sensitive intake remains off until legal review, official location data,
# private storage, and malware scanning are ready.
COMPLAINT_INTAKE_ENABLED=false


# ONVO Pay Costa Rica (Cobro en Colones CRC ₡3.500 / Tarjetas y SINPE Móvil)
# Obtenga sus credenciales en: https://dashboard.onvopay.com/developers
ONVO_SECRET_KEY=
ONVO_WEBHOOK_SECRET=
ONVO_PUBLIC_KEY=

# Enable after applying 0004_delete_empty_account.sql to the connected Supabase project.
ACCOUNT_DELETION_ENABLED=false
