# Payments are inert unless this flag is explicitly set to true.
ONVO_PAYMENTS_ENABLED=false
ONVO_SECRET_KEY=
ONVO_WEBHOOK_SECRET=
# Optional override; production normally uses https://api.onvopay.com
ONVO_API_BASE_URL=https://api.onvopay.com

# Sensitive intake remains off until legal review, official location data,
# private storage, and malware scanning are ready.
COMPLAINT_INTAKE_ENABLED=false

# Comma-separated owner/admin emails. Authentication alone never grants admin.
ADMIN_EMAILS=
